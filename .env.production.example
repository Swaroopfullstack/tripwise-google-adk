# SAFE TEMPLATE ONLY. Supply real values through your hosting secret manager.
# Application and protocol tokens below are placeholders, not usable credentials.
APP_ENV=production
RUN_MODE=live
DATA_DIR=/app/runtime
LLM_PROVIDER=google_genai
LLM_MODEL=gemini-3.8-flash
GOOGLE_API_KEY=REPLACE_LOCALLY_WITH_YOUR_GOOGLE_API_KEY
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
LLM_TEMPERATURE=1.0
LLM_TOP_P=
LLM_TOP_K=
LLM_MAX_TOKENS=1600
LLM_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=1
ALLOWED_MODELS_JSON={}
EMBEDDING_BACKEND=huggingface
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
# Set true after the configured model is downloaded into the deployment's cache.
EMBEDDING_LOCAL_ONLY=false
RETRIEVAL_K=4
RETRIEVAL_FETCH_K=16
RETRIEVAL_STRATEGY=hybrid
MAX_UPLOAD_MB=8
MAX_DATA_ROWS=5000
MAX_DATA_COLUMNS=50
ML_TIMEOUT_SECONDS=90
REQUESTS_PER_MINUTE=30
API_IDENTITIES_JSON={"REPLACE_WITH_RANDOM_ANALYST_TOKEN_24_PLUS_CHARS":{"tenant":"your_company","user":"analyst","role":"analyst"},"REPLACE_WITH_DIFFERENT_RANDOM_REVIEWER_TOKEN_24_PLUS_CHARS":{"tenant":"your_company","user":"manager","role":"reviewer"}}
MCP_HTTP_TOKEN=REPLACE_WITH_SEPARATE_RANDOM_PROTOCOL_TOKEN_24_PLUS_CHARS
GRADIO_PASSWORD=REPLACE_WITH_SEPARATE_RANDOM_GRADIO_PASSWORD_24_PLUS_CHARS
MCP_PORT=8010
A2A_HOST=127.0.0.1
A2A_PORT=8020
API_BASE_URL=http://api:8000
