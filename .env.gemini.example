# SAFE TEMPLATE: copy to .env locally and replace placeholders privately.
# This is LIVE mode: hosted model calls can incur provider usage charges.
APP_ENV=development
RUN_MODE=live
DATA_DIR=runtime
LLM_PROVIDER=google_genai
LLM_MODEL=gemini-3.8-flash
GOOGLE_API_KEY=REPLACE_LOCALLY_WITH_YOUR_GOOGLE_API_KEY
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
LLM_TEMPERATURE=
LLM_TOP_P=
LLM_TOP_K=
LLM_MAX_TOKENS=1600
LLM_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=1
ALLOWED_MODELS_JSON={}
EMBEDDING_BACKEND=huggingface
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_LOCAL_ONLY=false
RETRIEVAL_K=4
RETRIEVAL_FETCH_K=16
RETRIEVAL_STRATEGY=hybrid
MAX_UPLOAD_MB=8
MAX_DATA_ROWS=5000
MAX_DATA_COLUMNS=50
ML_TIMEOUT_SECONDS=90
REQUESTS_PER_MINUTE=30
# Blank uses local development identities. See the production example for deployment.
API_IDENTITIES_JSON=
MCP_HTTP_TOKEN=REPLACE_LOCALLY_WITH_A_SEPARATE_RANDOM_PROTOCOL_TOKEN
MCP_PORT=8010
A2A_HOST=127.0.0.1
A2A_PORT=8020
GRADIO_PASSWORD=
API_BASE_URL=http://127.0.0.1:8000
