# uv run loads no secrets automatically in production; local Settings reads .env.
APP_ENV=development
RUN_MODE=demo
DATA_DIR=runtime

# Every application uses the same init_chat_model factory.
LLM_PROVIDER=google_genai
LLM_MODEL=gemini-3.8-flash
GOOGLE_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# Optional: change both provider and model, e.g. openai / gpt-4o-mini.
LLM_TEMPERATURE=1.0
# Blank means omit and use the model/provider default.
LLM_TOP_P=
LLM_TOP_K=
LLM_MAX_TOKENS=1600
LLM_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=1
# Optional additional UI choices; each enabled provider needs its own key.
ALLOWED_MODELS_JSON={}

# Demo hashing embeddings are deterministic lexical features, not semantic embeddings.
# uv sync --extra embeddings, then set huggingface for actual semantic retrieval.
EMBEDDING_BACKEND=hashing
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
# After warming/download, true avoids network lookups and requires cached weights.
EMBEDDING_LOCAL_ONLY=false
RETRIEVAL_K=4
RETRIEVAL_FETCH_K=16
RETRIEVAL_STRATEGY=hybrid
MAX_UPLOAD_MB=8
MAX_DATA_ROWS=5000
MAX_DATA_COLUMNS=50
ML_TIMEOUT_SECONDS=90
REQUESTS_PER_MINUTE=30

# Development-only local identities are built in. Production requires your own
# JSON mapping secret bearer tokens to server-trusted tenant/user/role objects.
# Example shape (replace tokens; never commit real values):
# API_IDENTITIES_JSON={"replace-with-long-random-secret":{"tenant":"company","user":"analyst","role":"analyst"},"another-secret":{"tenant":"company","user":"reviewer","role":"reviewer"}}
API_IDENTITIES_JSON=
MCP_HTTP_TOKEN=
A2A_HOST=127.0.0.1
A2A_PORT=8020
GRADIO_PASSWORD=
MCP_PORT=8010
API_BASE_URL=http://127.0.0.1:8000
